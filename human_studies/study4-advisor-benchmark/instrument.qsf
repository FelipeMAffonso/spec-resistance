. Please do not share the specific options with future participants. Click the arrow to return to Prolific.</p></div>", "DataExportTag": "debrief", "QuestionType": "DB", "Selector": "TB", "Configuration": {"QuestionDescriptionOption": "UseText"}, "QuestionDescription": "Debrief", "ChoiceOrder": [], "Validation": {"Settings": {"Type": "None"}}, "GradingData": [], "Language": [], "DataVisibility": {"Private": false, "Hidden": false}, "DefaultChoices": false, "NextChoiceId": 4, "NextAnswerId": 1, "QuestionID": "QID29"}}, {"SurveyID": "SV_R6SKIcegNVUE53B", "Element": "RS", "PrimaryAttribute": "RS_PZAsK10RsoPb1Nd", "SecondaryAttribute": "Default Response Set", "TertiaryAttribute": null, "Payload": null}, {"SurveyID": "SV_R6SKIcegNVUE53B", "Element": "QC", "PrimaryAttribute": "Survey Question Count", "SecondaryAttribute": "29", "TertiaryAttribute": null, "Payload": null}, {"SurveyID": "SV_R6SKIcegNVUE53B", "Element": "SCO", "PrimaryAttribute": "Scoring", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"ScoringCategories": [], "ScoringCategoryGroups": [], "ScoringSummaryCategory": null, "ScoringSummaryAfterQuestions": 0, "ScoringSummaryAfterSurvey": 0, "DefaultScoringCategory": null, "AutoScoringCategory": null}}, {"SurveyID": "SV_R6SKIcegNVUE53B", "Element": "PROJ", "PrimaryAttribute": "CORE", "SecondaryAttribute": null, "TertiaryAttribute": "1.1.0", "Payload": {"ProjectCategory": "CORE", "SchemaVersion": "1.1.0"}}, {"SurveyID": "SV_R6SKIcegNVUE53B", "Element": "STAT", "PrimaryAttribute": "Survey Statistics", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"MobileCompatible": true, "ID": "Survey Statistics"}}]}