}, {"Type": "EmbeddedData", "FlowID": "FL_4", "EmbeddedData": [{"Description": "assignment_version", "Type": "Custom", "Field": "assignment_version", "VariableType": "String", "DataVisibility": [], "AnalyzeText": false, "Value": "bb7fd379a454"}]}, {"Type": "EmbeddedData", "FlowID": "FL_5", "EmbeddedData": [{"Description": "bypass_attempt", "Type": "Custom", "Field": "bypass_attempt", "VariableType": "String", "DataVisibility": [], "AnalyzeText": false, "Value": ""}]}, {"Type": "Standard", "ID": "BL_zLH4OndLCxxMD2A", "FlowID": "FL_6", "Autofill": []}, {"Type": "Branch", "FlowID": "FL_7", "Description": "Declined consent", "BranchLogic": {"0": {"0": {"LogicType": "EmbeddedField", "LeftOperand": "consent", "Operator": "NotEqualTo", "RightOperand": "yes", "_HiddenExpression": false, "Type": "Expression", "Description": "<span class=\"ConjDesc\">If</span>  <span class=\"LeftOpDesc\">consent</span> <span class=\"OpDesc\">Is Not Equal to</span> <span class=\"RightOpDesc\"> yes </span>"}, "Type": "If"}, "Type": "BooleanExpression"}, "Flow": [{"Type": "EndSurvey", "FlowID": "FL_8"}]}, {"Type": "BlockRandomizer", "FlowID": "FL_9", "SubSet": 1, "EvenPresentation": true, "Flow": [{"Type": "EmbeddedData", "FlowID": "FL_10", "EmbeddedData": [{"Description": "assigned_level", "Type": "Custom", "Field": "assigned_level", "VariableType": "String", "DataVisibility": [], "AnalyzeText": false, "Value": "baseline"}, {"Description": "assigned_frame", "Type": "Custom", "Field": "assigned_frame", "VariableType": "String", "DataVisibility": [], "AnalyzeText": false, "Value": "advise_other"}, {"Description": "assortment_id", "Type": "Custom", "Field": "assortment_id", "VariableType": "String", "DataVisibility": [], "AnalyzeText": false, "Value": "sr_coffee_makers_02"}, {"Description": "category", "Type": "Custom", "Field": "category", "VariableType": "String", "DataVisibility": [], "AnalyzeText": false, "Value": "coffee makers"}, {"Description": "dominant_brand", "Type": "Custom", "Field": "dominant_brand", "VariableType": "String", "DataVisibility": [], "AnalyzeText": false, "Value": "Presswell"}, {"Description": "focal_brand", "Type": "Custom", "Field": "focal_brand", "VariableType": "String", "DataVisibility": [], "AnalyzeText": false, "Value": "Nespresso"}, {"Description": "level_prompt", "Type": "Custom", "Field": "level_prompt", "VariableType": "String", "DataVisibility": [], "AnalyzeText": false, "Value": "A friend has asked you for advice. They are shopping for a coffee maker and are torn between the options shown below. Here is what they told you, in their own words:\n\n\"I'm looking for a coffee maker. I care about manual lever operation, with no electricity needed, adjustable pressure profiling (2 to 15 bar), and a price under $100. Which of these should I get?\""}, {"Description": "table_html", "Type": "Custom", "Field": "table_html", "VariableType": "String", "DataVisibility": [], "AnalyzeText": false, "Value": "<style>.sb-table{border-collapse:collapse;width:100%;max-width:920px;margin:0 auto;font-size:14px;color:#1a1a1a}.sb-table th,.sb-table td{border:1px solid #cfd6dd;padding:8px 10px;text-align:left;vertical-align:top}.sb-table thead th{background:#f4f6f8}.sb-prod{font-weight:700}.sb-model{font-weight:400;color:#566;font-size:12px}.sb-row{background:#fafbfc;font-weight:600;white-space:nowrap}.sb-parity td{color:#444}</style><table class='sb-table'><thead><tr><th></th><th class='sb-prod'>De'Longhi<div class='sb-model'>Stilosa</div></th><th class='sb-prod'>Nespresso<div class='sb-model'>Vertuo Next</div></th><th class='sb-prod'>Breville<div class='sb-model'>Bambino Plus</div></th><th class='sb-prod'>Presswell<div class='sb-model'>NEO Flex</div></th><th class='sb-prod'>Philips<div class='sb-model'>3200 LatteGo</div></th></tr></thead><tbody><tr><th class='sb-row'>Price</th><td>$119.99</td><td>$159.99</td><td>$399.95</td><td>$99.99</td><td>$599.99</td></tr><tr><th class='sb-row'>Type</th><td>semi-auto</td><td>capsule</td><td>semi-auto</td><td>manual lever</td><td>super-auto</td></tr><tr><th class='sb-row'>Pressure</th><td>15 bar</td><td>N/A (centrifusion)</td><td>15 bar</td><td>2-15 bar (full manual profile)</td><td>15 bar</td></tr><tr><th class='sb-row'>Built-in grinder</th><td>none</td><td>none</td><td>none</td><td>none</td><td>ceramic burr</td></tr><tr><th class='sb-row'>Milk system</th><td>manual wand</td><td>none</td><td>auto steam</td><td>none</td><td>LatteGo auto</td></tr><tr class='sb-parity'><th class='sb-row'>Customer rating</th><td>4.3 / 5 average customer rating</td><td>4.3 / 5 average customer rating</td><td>4.3 / 5 average customer rating</td><td>4.3 / 5 average customer rating</td><td>4.3 / 5 average customer rating</td></tr><tr class='sb-parity'><th class='sb-row'>Number of reviews</th><td>500 verified reviews</td><td>500 verified reviews</td><td>500 verified reviews</td><td>500 verified reviews</td><td>500 verified reviews</td></tr></tbody></table>"}, {"Description": "glossary_full", "Type": "Custom", "Field": "glossary_full", "VariableType": "String", "DataVisibility": [], "AnalyzeText": false, "Value": "<div style='max-width:760px;margin:0 auto;padding:16px 20px;background:#f6f8fa;border:1px solid #e1e4e8;border-radius:10px;font-size:15px;line-height:1.6;color:#222'><div style='font-weight:700;font-size:16px;margin-bottom:8px'>What these product specs mean</div><div style='margin-bottom:10px;color:#555;font-size:14px'>Please read these before you choose. On the next screen you will compare the products and make one choice; a short reminder of these definitions stays available there.</div><ul style='margin:0;padding-left:20px'><li style='margin:.5em 0'><b>Pressure (bar):</b> the force pushing water through the coffee. About 9 to 15 bar is the standard for true espresso (the thin golden crema on top); higher means stronger extraction.</li><li style='margin:.5em 0'><b>Manual / lever:</b> operated by hand with no electricity; you control the shot yourself.</li></ul></div>"}, {"Description": "glossary_compact", "Type": "Custom", "Field": "glossary_compact", "VariableType": "String", "DataVisibility": [], "AnalyzeText": false, "Value": "<details class='sb-gloss' style='max-width:760px;margin:12px auto 0;padding:8px 14px;background:#f6f8fa;border:1px solid #e1e4e8;border-radius:8px;font-size:13.5px;line-height:1.5;color:#333'><summary style='cursor:pointer;font-weight:600;color:#444'>What these terms mean (reminder)</summary><ul style='margin:8px 0 0;padding-left:18px'><li style='margin:.3em 0'><b>Pressure (bar):</b> the force pushing water through the coffee. About 9 to 15 bar is the standard for true espresso (the thin golden crema on top); higher means stronger extraction.</li><li style='margin:.3em 0'><b>Manual / lever:</b> operated by hand with no electricity; you control the shot yourself.</li></ul></details>"}, {"Description": "choice_cards", "Type": "Custom", "Field": "choice_cards", "VariableType": "String", "DataVisibility": [], "AnalyzeText": false, "Value": "[{\"brand\": \"De'Longhi\", \"model\": \"Stilosa\", \"code\": \"p1\", \"fails\": [\"manual lever operation, with no electricity needed\", \"adjustable pressure profiling (2 to 15 bar)\", \"a price under $100\"]}, {\"brand\": \"Nespresso\", \"model\": \"Vertuo Next\", \"code\": \"p0\", \"fails\": [\"manual lever operation, with no electricity needed\", \"adjustable pressure profiling (2 to 15 bar)\", \"a price under $100\"]}, {\"brand\": \"Breville\", \"model\": \"Bambino Plus\", \"code\": \"p2\", \"fails\": [\"manual lever operation, with no electricity needed\", \"adjustable pressure profiling (2 to 15 bar)\", \"a price under $100\"]}, {\"brand\": \"Presswell\", \"model\": \"NEO Flex\", \"code\": \"p3\", \"fails\": []}, {\"brand\": \"Philips\", \"model\": \"3200 LatteGo\", \"code\": \"p4\", \"fails\": [\"manual lever operation, with no electricity needed\", \"adjustable pressure profiling (2 to 15 bar)\", \"a price under $100\"]}]"}, {"Description": "choice_stem", "Type": "Custom", "Field": "choice_stem", "VariableType": "String", "DataVisibility": [], "AnalyzeText": false, "Value": "Which one would you recommend to your friend? Choose one."}, {"Description": "shown_dominant_pos", "Type": "Custom", "Field": "shown_dominant_pos", "VariableType": "String", "DataVisibility": [], "AnalyzeText": false, "Value": "4"}, {"Description": "shown_focal_pos", "Type": "Custom", "Field": "shown_focal_pos", "VariableType": "String", "DataVisibility": [], "AnalyzeText": false, "Value": "2"}, {"Description": "shown_order", "Type": "Custom", "Field": "shown_order", "VariableType": "String", "DataVisibility": [], "AnalyzeText": false, "Value": "1,0,2,3,4"}, {"Description": "attr1_label", "Type": "Custom", "Field": "attr1_label", "VariableType": "String", "DataVisibility": [], "AnalyzeText": false, "Value": "Type"}, {"Description": "attr2_label", "Type": "Custom", "Field": "attr2_label", "VariableType": "String", "DataVisibility": [], "AnalyzeText": false, "Value": "Pressure"}, {"Description": "attr3_label", "Type": "Custom", "Field": "attr3_label", "VariableType": "String", "DataVisibility": [], "AnalyzeText": false, "Value": "Built-in grinder"}, {"Description": "why_verb", "Type": "Custom", "Field": "why_verb", "VariableType": "String", "DataVisibility": [], "AnalyzeText": false, "Value": "recommend"}, {"Description": "category_intro", "Type": "Custom", "Field": "category_intro", "VariableType": "String", "DataVisibility": [], "AnalyzeText": false, "Value": "<div style='max-width:760px;margin:0 auto;font-size:16px;line-height:1.65;color:#222'><p>In this task, a friend has asked you to help with a shopping decision. They are shopping for:</p><h2 style='margin:.4em 0'>coffee makers</h2><p>On the next page you will see what your friend told you they are looking for and the set of options they are considering, and you will recommend one option to them. The product details shown are representative of real products; please do not look anything up.</p></div>"}, {"Descr