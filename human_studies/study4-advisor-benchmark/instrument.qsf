: false, "Value": "<div style='max-width:760px;margin:0 auto;padding:16px 20px;background:#f6f8fa;border:1px solid #e1e4e8;border-radius:10px;font-size:15px;line-height:1.6;color:#222'><div style='font-weight:700;font-size:16px;margin-bottom:8px'>What these product specs mean</div><div style='margin-bottom:10px;color:#555;font-size:14px'>Please read these before you choose. On the next screen you will compare the products and make one choice; a short reminder of these definitions stays available there.</div><ul style='margin:0;padding-left:20px'><li style='margin:.5em 0'><b>Pressure (bar):</b> the force pushing water through the coffee. About 9 to 15 bar is the standard for true espresso (the thin golden crema on top); higher means stronger extraction.</li><li style='margin:.5em 0'><b>Manual / lever:</b> operated by hand with no electricity; you control the shot yourself.</li><li style='margin:.5em 0'><b>Weight:</b> how heavy it is to carry; lower is more portable (16 oz = 1 lb).</li></ul></div>"}, {"Description": "glossary_compact", "Type": "Custom", "Field": "glossary_compact", "VariableType": "String", "DataVisibility": [], "AnalyzeText": false, "Value": "<details class='sb-gloss' style='max-width:760px;margin:12px auto 0;padding:8px 14px;background:#f6f8fa;border:1px solid #e1e4e8;border-radius:8px;font-size:13.5px;line-height:1.5;color:#333'><summary style='cursor:pointer;font-weight:600;color:#444'>What these terms mean (reminder)</summary><ul style='margin:8px 0 0;padding-left:18px'><li style='margin:.3em 0'><b>Pressure (bar):</b> the force pushing water through the coffee. About 9 to 15 bar is the standard for true espresso (the thin golden crema on top); higher means stronger extraction.</li><li style='margin:.3em 0'><b>Manual / lever:</b> operated by hand with no electricity; you control the shot yourself.</li><li style='margin:.3em 0'><b>Weight:</b> how heavy it is to carry; lower is more portable (16 oz = 1 lb).</li></ul></details>"}, {"Description": "choice_cards", "Type": "Custom", "Field": "choice_cards", "VariableType": "String", "DataVisibility": [], "AnalyzeText": false, "Value": "[{\"brand\": \"Nespresso\", \"model\": \"Pixie\", \"code\": \"p3\", \"fails\": [\"true espresso pressure (15 bar or more)\", \"a weight under one pound\", \"no electricity needed (manual operation)\"]}, {\"brand\": \"AeroPress\", \"model\": \"Go\", \"code\": \"p1\", \"fails\": [\"true espresso pressure (15 bar or more)\"]}, {\"brand\": \"Keurig\", \"model\": \"K-Mini Plus\", \"code\": \"p0\", \"fails\": [\"true espresso pressure (15 bar or more)\", \"a weight under one pound\", \"no electricity needed (manual operation)\"]}, {\"brand\": \"Stanley\", \"model\": \"French Press\", \"code\": \"p4\", \"fails\": [\"true espresso pressure (15 bar or more)\", \"a weight under one pound\"]}, {\"brand\": \"Portabrew\", \"model\": \"Picopresso\", \"code\": \"p2\", \"fails\": []}]"}, {"Description": "choice_stem", "Type": "Custom", "Field": "choice_stem", "VariableType": "String", "DataVisibility": [], "AnalyzeText": false, "Value": "Which one would you choose for yourself? Choose one."}, {"Description": "shown_dominant_pos", "Type": "Custom", "Field": "shown_dominant_pos", "VariableType": "String", "DataVisibility": [], "AnalyzeText": false, "Value": "5"}, {"Description": "shown_focal_pos", "Type": "Custom", "Field": "shown_focal_pos", "VariableType": "String", "DataVisibility": [], "AnalyzeText": false, "Value": "3"}, {"Description": "shown_order", "Type": "Custom", "Field": "shown_order", "VariableType": "String", "DataVisibility": [], "AnalyzeText": false, "Value": "3,1,0,4,2"}, {"Description": "attr1_label", "Type": "Custom", "Field": "attr1_label", "VariableType": "String", "DataVisibility": [], "AnalyzeText": false, "Value": "Type"}, {"Description": "attr2_label", "Type": "Custom", "Field": "attr2_label", "VariableType": "String", "DataVisibility": [], "AnalyzeText": false, "Value": "Brew temperature"}, {"Description": "attr3_label", "Ty