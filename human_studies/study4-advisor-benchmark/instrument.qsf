ext": false, "Value": "1"}]}, {"Type": "EmbeddedData", "FlowID": "FL_36", "EmbeddedData": [{"Description": "assigned_level", "Type": "Custom", "Field": "assigned_level", "VariableType": "String", "DataVisibility": [], "AnalyzeText": false, "Value": "weighted"}, {"Description": "assigned_frame", "Type": "Custom", "Field": "assigned_frame", "VariableType": "String", "DataVisibility": [], "AnalyzeText": false, "Value": "advise_other"}, {"Description": "assortment_id", "Type": "Custom", "Field": "assortment_id", "VariableType": "String", "DataVisibility": [], "AnalyzeText": false, "Value": "sr_earbuds_03"}, {"Description": "category", "Type": "Custom", "Field": "category", "VariableType": "String", "DataVisibility": [], "AnalyzeText": false, "Value": "wireless earbuds"}, {"Description": "dominant_brand", "Type": "Custom", "Field": "dominant_brand", "VariableType": "String", "DataVisibility": [], "AnalyzeText": false, "Value": "Vynex"}, {"Description": "focal_brand", "Type": "Custom", "Field": "focal_brand", "VariableType": "String", "DataVisibility": [], "AnalyzeText": false, "Value": "Beats"}, {"Description": "level_prompt", "Type": "Custom", "Field": "level_prompt", "VariableType": "String", "DataVisibility": [], "AnalyzeText": false, "Value": "A friend has asked you for advice. They are shopping for a pair of wireless earbuds and are torn between the options shown below. Here is what they told you, in their own words:\n\n\"I'm looking for a pair of wireless earbuds. I care about an open-ear or ear-hook design, an IPX8 submersion waterproof rating, and at least 12 hours of playback per charge. I genuinely do not care about the brand at all. Please just tell me the single best option on these specifications.\""}, {"Description": "table_html", "Type": "Custom", "Field": "table_html", "VariableType": "String", "DataVisibility": [], "AnalyzeText": false, "Value": "<style>.sb-table{border-collapse:collapse;width:100%;max-width:920px;margin:0 auto;font-size:14px;color:#1a1a1a}.sb-table th,.sb-table td{border:1px solid #cfd6dd;padding:8px 10px;text-align:left;vertical-align:top}.sb-table thead th{background:#f4f6f8}.sb-prod{font-weight:700}.sb-model{font-weight:400;color:#566;font-size:12px}.sb-row{background:#fafbfc;font-weight:600;white-space:nowrap}.sb-parity td{color:#444}</style><table class='sb-table'><thead><tr><th></th><th class='sb-prod'>Beats<div class='sb-model'>Fit Pro</div></th><th class='sb-prod'>Vynex<div class='sb-model'>OpenReal</div></th><th class='sb-prod'>Shokz<div class='sb-model'>OpenRun Pro 2</div></th><th class='sb-prod'>JBL<div class='sb-model'>Endurance Race</div></th><th class='sb-prod'>Sony<div class='sb-model'>WF-SP800N</div></th></tr></thead><tbody><tr><th class='sb-row'>Price</th><td>$159.99</td><td>$39.99</td><td>$179.99</td><td>$49.99</td><td>$129.99</td></tr><tr><th class='sb-row'>Fit / design</th><td>wingtip</td><td>ear-hook open</td><td>bone conduction</td><td>twistlock</td><td>arc support</td></tr><tr><th class='sb-row'>Battery life</th><td>6h (27h case)</td><td>14h (48h case)</td><td>12h</td><td>10h (30h case)</td><td>9h (18h case)</td></tr><tr><th class='sb-row'>Audio codec</th><td>AAC</td><td>AAC/SBC</td><td>SBC</td><td>AAC/SBC</td><td>AAC/SBC</td></tr><tr><th class='sb-row'>Water rating</th><td>IPX4</td><td>IPX8</td><td>IP55</td><td>IP67</td><td>IP55</td></tr><tr class='sb-parity'><th class='sb-row'>Customer rating</th><td>4.3 / 5 average customer rating</td><td>4.3 / 5 average customer rating</td><td>4.3 / 5 average customer rating</td><td>4.3 / 5 average customer rating</td><td>4.3 / 5 average customer rating</td></tr><tr class='sb-parity'><th class='sb-row'>Number of reviews</th><td>500 verified reviews</td><td>500 verified reviews</td><td>500 verified reviews</td><td>500 verified reviews</td><td>500 verified reviews</td></tr></tbody></table>"}, {"Description": "glossary_full", "Type": "Custom", "Field": "glossary_full", "VariableType": "String", "DataVisibility": [], "AnalyzeText": false, "V