ility": [], "AnalyzeText": false, "Value": "Some people expect that shoppers tend to stick with the brand they already know."}]}, {"Type": "EmbeddedData", "FlowID": "FL_43", "EmbeddedData": [{"Description": "demand_cell", "Type": "Custom", "Field": "demand_cell", "VariableType": "String", "DataVisibility": [], "AnalyzeText": false, "Value": "control"}, {"Description": "demand_framing", "Type": "Custom", "Field": "demand_framing", "VariableType": "String", "DataVisibility": [], "AnalyzeText": false, "Value": ""}]}]}, {"Type": "Standard", "ID": "BL_uzZaZr3YxuKx3ja", "FlowID": "FL_44", "Autofill": []}, {"Type": "Standard", "ID": "BL_a3pnpXiXE4jY9Oe", "FlowID": "FL_45", "Autofill": []}, {"Type": "Standard", "ID": "BL_uOaE2v4tZPiiF15", "FlowID": "FL_46", "Autofill": []}, {"Type": "Standard", "ID": "BL_ChAYK5Flue3JepQ", "FlowID": "FL_47", "Autofill": []}, {"Type": "Standard", "ID": "BL_0DFxej3y9qTYxmG", "FlowID": "FL_48", "Autofill": []}, {"Type": "Standard", "ID": "BL_dBJAvWxlsI2NMcV", "FlowID": "FL_49", "Autofill": []}, {"Type": "Standard", "ID": "BL_JWfqK5mEZDcYA7A", "FlowID": "FL_50", "Autofill": []}, {"Type": "Standard", "ID": "BL_5MtT2QFiTGNB7Ei", "FlowID": "FL_51", "Autofill": []}, {"Type": "Standard", "ID": "BL_aKZaWT9Ijk4OOO6", "FlowID": "FL_52", "Autofill": []}, {"Type": "Standard", "ID": "BL_bPLIQ838DrzvFKz", "FlowID": "FL_53", "Autofill": []}, {"Type": "Standard", "ID": "BL_kn0FD9gCQpmRAvi", "FlowID": "FL_54", "Autofill": []}, {"Type": "Standard", "ID": "BL_fZvSUVlUHjKeMAZ", "FlowID": "FL_55", "Autofill": []}, {"Type": "Standard", "ID": "BL_ghN3izIxsGznKf5", "FlowID": "FL_56", "Autofill": []}, {"Type": "EndSurvey", "FlowID": "FL_57", "EndingType": "Advanced", "Options": {"Advanced": "true", "SurveyTermination": "Redirect", "EOSRedirectURL": "https://app.prolific.com/submissions/complete?cc=SRCONF9X4T"}}], "Properties": {"Count": 300, "RemovedFieldsets": []}}}, {"SurveyID": "SV_R6SKIcegNVUE53B", "Element": "SO", "PrimaryAttribute": "Survey Options", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"BackButton": "false", "SaveAndContinue": "true", "SurveyProtection": "PublicSurvey", "BallotBoxStuffingPrevention": "true", "RecaptchaV3": "true", "NoIndex": "Yes", "SecureResponseFiles": "true", "AnonymizeResponse": "Yes", "SurveyExpiration": "None", "SurveyTermination": "DefaultMessage", "Header": "", "Footer": "", "ProgressBarDisplay": "Text", "PartialData": "+1 week", "ValidationMessage": "", "PreviousButton": "", "NextButton": " &#8594; ", "SurveyTitle": "Shopping Recommendation Study", "SkinLibrary": "qualtrics", "SkinType": "templated", "Skin": {"brandingId": null, "templateId": "*base", "overrides": null}, "NewScoring": 1}}, {"SurveyID": "SV_R6SKIcegNVUE53B", "Element": "SQ", "PrimaryAttribute": "QID1", "SecondaryAttribute": "Consent", "TertiaryAttribute": null, "Payload": {"QuestionText": "<style>\n.cfx-stem{font-size:16px;line-height:1.55;color:#1a1a1a;max-width:920px;margin:0 auto 14px}\n.cfx-opts{max-width:920px;margin:0 auto;display:flex;flex-direction:column;gap:10px}\n.cfx-card{display:block;border:1px solid #cfd6dd;border-radius:10px;padding:12px 14px;cursor:pointer;background:#fff;transition:border-color .12s,box-shadow .12s}\n.cfx-card:hover{border-color:#9bb0c4}\n.cfx-card.sel{border-color:#1f5fae;box-shadow:0 0 0 2px rgba(31,95,174,.18)}\n.cfx-card input{margin-right:10px;transform:translateY(1px)}\n.cfx-cardbrand{font-weight:700;color:#16243a}\n.cfx-cardmodel{font-weight:400;color:#566;font-size:13px}\n.cfx-err{display:none;color:#b00020;max-width:920px;margin:0 auto 10px;font-size:15px}\n.cs-wrap{max-width:760px;margin:0 auto;font-size:15px;line-height:1.6;color:#222}\n.cs-actions{display:flex;gap:12px;margin-top:18px;flex-wrap:wrap}\n.cs-btn{font-size:15px;padding:10px 16px;border:1px solid #1f5fae;border-radius:8px;background:#fff;color:#1f5fae;cursor:pointer}\n.cs-btn.on{background:#1f5fae;color:#fff}\n.cs-note{margin-top:12px;color:#444;min-height:20px}\n.sb-prompt{max-width:920px;margin:0 auto 16px;font-size:15px;line-height:1.6;color:#222;background:#f4f6f8;border:1px solid #dde3e9;border-radius:8px;padding:14px 16px;white-space:pre-wrap}\n</style><div class='cs-wrap'><p style='text-align:center;font-weight:700'>School of Marketing and International Business</p>\n<p style='text-align:center;font-weight:700'>CONSENT FORM -- PROLIFIC</p>\n<p style='font-weight:700;margin-top:12px'>Study Title: \"Consumer Decision Making Study\"</p>\n<p style='font-weight:700;margin-top:12px'>Background Information</p>\n<p>We are inviting you to be part of a research study about how consumers evaluate product information and make purchasing decisions. We seek to understand how people use product comparison information to choose products. This form will tell you what the study is about, what we will ask you to do, and how your information will be used. Please read this carefully. Feel free to ask questions if you don't understand something. Taking part in this study is completely your choice. You can decide not to join, or if you join, you can stop at any time. There is no punishment or penalty if you decide not to take part or if you quit later.</p>\n<p>This study is being conducted by:</p>\n<p>This study is being done by Felipe M. Affonso from School of Marketing and International Business at Oklahoma State University.</p>\n<p style='font-weight:700;margin-top:12px'>Procedures</p>\n<p>If you decide to join, we will ask you to:</p>\n<p>Fill out a survey about consumer product evaluation and decision making. You will state your product preferences, view product comparison information, make a product selection, and answer questions about your decision.</p>\n<p>It will take about 6 minutes.</p>\n<p style='font-weight:700;margin-top:12px'>Benefits and Risks of being in the Study</p>\n<p>You may not get direct benefits from this study, but your participation could help researchers learn more about consumer decision-making and help others in the future.</p>\n<p>This study involves the following risks:</p>\n<p>There are no risks in this study that are greater than what you experience in daily life.</p>\n<p>We will take steps to reduce these risks by:</p>\n<p>If any question makes you uncomfortable, you can skip it or choose to quit the study at any time.</p>\n<p>Will You get Paid?</p>\n<p>You will be paid for taking part in the study. You will get compensation after you finish the study. You will be paid $0.20 per minute ($1.20 for a 6-minute survey). If the research team discovers that participants falsified their identity to meet eligibility criteria, the team reserves the right to dismiss the participant from the study and not pay them for participation.</p>\n<p>Prolific does not allow for prorated compensation. In the event of an incomplete submission, you must contact the research team, and compensation will be determined based on what was completed and at the researchers' discretion.</p>\n<p>PLEASE NOTE: This study contains a number of checks to make sure that participants are finishing the tasks honestly and completely. We are following Prolific's policies. As long as you read the instructions and complete the tasks, your submission will be approved. If you fail these checks, your submission will be rejected.</p>\n<p>Approved: [DATE]</p>\n<p>Protocol #: [NUMBER]</p>\n<p>How Will Your Information Be Kept Private?</p>\n<p>The information you share in this study will be anonymous. This means your name will not be collected or connected to your answers. Once you finish the study, we will not be able to remove your data because it will not be linked to you.</p>\n<p>Your Prolific ID will be used to distribute payment to you, but will not be stored with the research data we collect from you.</p>\n<p>The research team will do its best to keep your information private, using the technology available. However, because you are answering online, there is a small chance that someone who is not supposed to could see your answers. This risk is similar to what you might face when using the internet in daily life. If you have concerns, you can check the privacy policy of the online provider here: www.qualtrics.com/privacy-statement/</p>\n<p>How Your Information Will Be Collected and Stored?</p>\n<p>We will collect your information using surveys using the Qualtrics survey software. Your information will be stored in:</p>\n<p>- Qualtrics Servers (encrypted and password-protected)</p>\n<p>- Local data files (encrypted and password-protected on a hard drive inside the University)</p>\n<p style='font-weight:700;margin-top:12px'>Contacts and Questions</p>\n<p>The Institutional Review Board (IRB) for the protection of human research participants at Oklahoma State University has reviewed and approved this study. If you have questions about the research study itself, please contact the Principal Investigator at (405) 744-1311, felipe.affonso@okstate.edu. If you have questions about your rights as a research volunteer or would simply like to speak with someone other than the research team about concerns regarding this study, please contact the IRB at (405) 744-3377 or irb@okstate.edu. All reports or correspondence will be kept confidential.</p>\n<p>Statement of Consent</p>\n<p>I have read this form and understand what the study is about. I have had the chance to ask questions. By signing this, I agree to take part in the study.</p>\n<p>If you agree to join the study, please click I agree and continue.</p>\n<p>Approved: [DATE]</p>\n<p>Protocol #: [NUMBER]</p><div class='cs-actions'><button type='button' id='cs-agree' class='cs-btn'>Yes, I consent and wish to begin</button><button type='button' id='cs-decline' class='cs-btn'>No, I do not consent</button></div><div id='cs-note' class='cs-note'></div></div>", "QuestionText_Unsafe": "<style>\n.cfx-stem{font-size:16px;line-height:1.55;color:#1a1a1a;max-width:920px;margin:0 auto 14px}\n.cfx-opts{max-width:920px;margin:0 auto;display:flex;flex-direction:column;gap:10px}\n.cfx-card{display:block;border:1px solid #cfd6dd;border-radius:10px;padding:12px 14px;cursor:pointer;background:#fff;transition:border-color .12s,box-shadow .12s}\n.cfx-card:hover{border-color:#9bb0c4}\n.cfx-card.sel{border-color:#1f5fae;box-shadow:0 0 0 2px rgba(31,95,174,.18)}\n.cfx-card input{margin-right:10px;transform:translateY(1px)}\n.cfx-cardbrand{font-weight:700;color:#16243a}\n.cfx-cardmodel{font-weight:400;color:#566;font-size:13px}\n.cfx-err{display:none;color:#b00020;max-width:920px;margin:0 auto 10px;font-size:15px}\n.cs-wrap{max-width:760px;margin:0 auto;font-size:15px;line-height:1.6;color:#222}\n.cs-actions{display:flex;gap:12px;margin-top:18px;flex-wrap:wrap}\n.cs-btn{font-size:15px;padding:10px 16px;border:1px solid #1f5fae;border-radius:8px;background:#fff;color:#1f5fae;cursor:pointer}\n.cs-btn.on{background:#1f5fae;color:#fff}\n.cs-note{margin-top:12px;color:#444;min-height:20px}\n.sb-prompt{max-width:920px;margin:0 auto 16px;font-size:15px;line-height:1.6;color:#222;background:#f4f6f8;border:1px solid #dde3e9;border-radius:8px;padding:14px 16px;white-space:pre-wrap}\n</style><div class='cs-wrap'><p style='text-align:center;font-weight:700'>School of Marketing and International Business</p>\n<p style='text-align:center;font-weight:700'>CONSENT FORM -- PROLIFIC</p>\n<p style='font-weight:700;margin-top:12px'>Study Title: \"Consumer Decision Making Study\"</p>\n<p style='font-weight:700;margin-top:12px'>Background Information</p>\n<p>We are inviting you to be part of a research study about how consumers evaluate product information and make purchasing decisions. We seek to understand how people use product comparison information to choose products. This form will tell you what the study is about, what we will ask you to do, and how your information will be used. Please read this carefully. Feel free to ask questions if you don't understand something. Taking part in this study is completely your choice. You can decide not to join, or if you join, you can stop at any time. There is no punishment or penalty if you decide not to take part or if you quit later.</p>\n<p>This study is being conducted by:</p>\n<p>This study is being done by Felipe M. Affonso from School of Marketing and International Business at Oklahoma State University.</p>\n<p style='font-weight:700;margin-top:12px'>Procedures</p>\n<p>If you decide to join, we will ask you to:</p>\n<p>Fill out a survey about consumer product evaluation and decision making. You will state your product preferences, view product comparison information, make a product selection, and answer questions about your decision.</p>\n<p>It will take about 6 minutes.</p>\n<p style='font-weight:700;margin-top:12px'>Benefits and Risks of being in the Study</p>\n<p>You may not get direct benefits from this study, but your participation could help researchers learn more about consumer decision-making and help others in the future.</p>\n<p>This study involves the following risks:</p>\n<p>There are no risks in this study that are greater than what you experience in daily life.</p>\n<p>We will take steps to reduce these risks by:</p>\n<p>If any question makes you uncomfortable, you can skip it or choose to quit the study at any time.</p>\n<p>Will You get Paid?</p>\n<p>You will be paid for taking part in the study. You will get compensation after you finish the study. You will be paid $0.20 per minute ($1.20 for a 6-minute survey). If the research team discovers that participants falsified their identity to meet eligibility criteria, the team reserves the right to dismiss the participant from the study and not pay them for participation.</p>\n<p>Prolific does not allow for prorated compensation. In the event of an incomplete submission, you must contact the research team, and compensation will be determined based on what was completed and at the researchers' discretion.</p>\n<p>PLEASE NOTE: This study contains a number of checks to make sure that participants are finishing the tasks honestly and completely. We are following Prolific's policies. As long as you read the instructions and complete the tasks, your submission will be approved. If you fail these checks, your submission will be rejected.</p>\n<p>Approved: [DATE]</p>\n<p>Protocol #: [NUMBER]</p>\n<p>How Will Your Information Be Kept Private?</p>\n<p>The information you share in this study will be anonymous. This means your name will not be collected or connected to your answers. Once you finish the study, we will not be able to remove your data because it will not be linked to you.</p>\n<p>Your Prolific ID will be used to distribute payment to you, but will not be stored with the research data we collect from you.</p>\n<p>The research team will do its best to keep your information private, using the technology available. However, because you are answering online, there is a small chance that someone who is not supposed to could see your answers. This risk is similar to what you might face when using the internet in daily life. If you have concerns, you can check the privacy policy of the online provider here: www.qualtrics.com/privacy-statement/</p>\n<p>How Your Information Will Be Collected and Stored?</p>\n<p>We will collect your information using surveys using the Qualtrics survey software. Your information will be stored in:</p>\n<p>- Qualtrics Servers (encrypted and password-protected)</p>\n<p>- Local data files (encrypted and password-protected on a hard drive inside the University)</p>\n<p style='font-weight:700;margin-top:12px'>Contacts and Questions</p>\n<p>The Institutional Review Board (IRB) for the protection of human research participants at Oklahoma State University has reviewed and approved this study. If you have questions about the research study itself, please contact the Principal Investigator at (405) 744-1311, felipe.affonso@okstate.edu. If you have questions about your rights as a research volunteer or would simply like to speak with someone other than the research team about concerns regarding this study, please contact the IRB at (405) 744-3377 or irb@okstate.edu. All reports or correspondence will be kept confidential.</p>\n<p>Statement of Consent</p>\n<p>I have read this form and understand what the study is about. I have had the chance to ask questions. By signing this, I agree to take part in the study.</p>\n<p>If you agree to join the study, please click I agree and continue.</p>\n<p>Approved: [DATE]</p>\n<p>Protocol #: [NUMBER]</p><div class='cs-actions'><button type='button' id='cs-agree' class='cs-btn'>Yes, I consent and wish to begin</button><button type='button' id='cs-decline' class='cs-btn'>No, I do not consent</button></div><div id='cs-note' class='cs-note'></div></div>", "DataExportTag": "consent_q", "QuestionType": "DB", "Selector": "TB", "Configuration": {"QuestionDescriptionOption": "UseText"}, "QuestionDescription": "Consent", "ChoiceOrder": [], "Validation": {"Settings": {"Type": "None"}}, "GradingData": [], "Language": [], "DataVisibility": {"Private": false, "Hidden": false}, "DefaultChoices": false, "NextChoiceId": 4, "NextAnswerId": 1, "QuestionID": "QID1", "QuestionJS": "Qualtrics.SurveyEngine.addOnload(function(){});\nQualtrics.SurveyEngine.addOnReady(function(){\n  var self=this;\n  function ed(k,v){ try{ Qualtrics.SurveyEngine.setEmbeddedData(k,v); }catch(e){} }\n  function $(id){ return document.getElementById(id); }\n  self.hideNextButton();\n  var gs=document.createElement('style'); gs.id='cs-gate-style';\n  gs.textContent='#NextButton,input[id=\\\"NextButton\\\"]{display:none !important;visibility:hidden !important;pointer-events:none !important;}#PreviousButton{display:none !important;}';\n  document.head.appendChild(gs); var done=false;\n  var obs=new MutationObserver(function(){ if(done)return; if(!document.getElementById('cs-gate-style'))document.head.appendChild(gs); });\n  try{ obs.observe(document.head,{childList:true}); }catch(e){}\n  setTimeout(function(){ if(!done)self.hideNextButton(); },500);\n  setTimeout(function(){ if(!done)self.hideNextButton(); },2000);\n  setTimeout(function(){ if(!done)self.hideNextButton(); },5000);\n  Qualtrics.SurveyEngine.addOnPageSubmit(function(type){ if(type==='next'&&!done){ try{Qualtrics.SurveyEngine.setEmbeddedData('bypass_attempt','true');}catch(e){} } });\n  function unlock(){ if(done)return; done=true; try{obs.disconnect();}catch(e){}\n    var g=document.getElementById('cs-gate-style'); if(g&&g.parentNode)g.parentNode.removeChild(g);\n    try{self.showNextButton();}catch(e){}\n    var nb=document.getElementById('NextButton'); if(nb){nb.style.display='';nb.style.visibility='';nb.style.pointerEvents='';nb.removeAttribute('disabled');}\n    setTimeout(function(){try{self.showNextButton();}catch(e){}},120); }\n  function choose(val){\n    ed('consent', val);\n    var a=$('cs-agree'), d=$('cs-decline');\n    if(a)a.classList.toggle('on', val==='yes'); if(d)d.classList.toggle('on', val==='no');\n    var note=$('cs-note'); if(note){ note.textContent=(val==='yes')?'Thank you. Click the arrow below to begin.':'You have declined. Click the arrow below to exit the study.'; }\n    unlock();\n  }\n  var a=$('cs-agree'); if(a)a.addEventListener('click',function(){ choose('yes'); });\n  var d=$('cs-decline'); if(d)d.addEventListener('click',function(){ choose('no'); });\n});\n"}}, {"SurveyID": "SV_R6SKIcegNVUE53B", "Element": "SQ", "PrimaryAttribute": "QID2", "SecondaryAttribute": "Captcha", "TertiaryAttribute": null, "Payload": {"QuestionText": "Please verify that you are human.", "QuestionType": "Captcha", "Selector": "V2", "DataExportTag": "captcha_1", "Configuration": {"QuestionDescriptionOption": "UseText"}, "QuestionDescription": "Captcha", "Validation": {"Settings": {"ForceResponse": "ON", "Type": "None"}}, "GradingData": [], "Language": [], "DataVisibility": {"Private": false, "Hidden": false}, "NextChoiceId": 4, "NextAnswerId": 1, "QuestionID": "QID2"}}, {"SurveyID": "SV_R6SKIcegNVUE53B", "Element": "SQ", "PrimaryAttribute": "QID3", "SecondaryAttribute": "Browser meta", "TertiaryAttribute": null, "Payload": {"QuestionText": "Browser Meta Info", "QuestionText_Unsafe": "Browser Meta Info", "QuestionType": "Meta", "Selector": "Browser", "DataExportTag": "browser_meta", "Configuration": {"QuestionDescriptionOption": "UseText"}, "QuestionDescription": "Browser meta", "GradingData": [], "Language": [], "DataVisibility": {"Private": false, "Hidden": false}, "DefaultChoices": false, "NextChoiceId": 4, "NextAnswerId": 1, "QuestionID": "QID3", "Choices": {"1": {"Display": "Browser", "TextEntry": 1}, "2": {"Display": "Version", "TextEntry": 1}, "3": {"Display": "Operating System", "TextEntry": 1}, "4": {"Display": "Screen Resolution", "TextEntry": 1}, "5": {"Display": "Flash Version", "TextEntry": 1}, "6": {"Display": "Java Support", "TextEntry": 1}, "7": {"Display": "User Agent", "TextEntry": 1}}}}, {"SurveyID": "SV_R6SKIcegNVUE53B", "Element": "SQ", "PrimaryAttribute": "QID4", "SecondaryAttribute": "Category disclosed", "TertiaryAttribute": null, "Payload": {"QuestionText": "${e://Field/category_intro}", "QuestionText_Unsafe": "${e://Field/category_intro}", "DataExportTag": "category_disclosed", "QuestionType": "DB", "Selector": "TB", "Configuration": {"QuestionDescriptionOption": "UseText"}, "QuestionDescription": "Category disclosed", "ChoiceOrder": [], "Validation": {"Settings": {"Type": "None"}}, "GradingData": [], "Language": [], "DataVisibility": {"Private": false, "Hidden": false}, "DefaultChoices": false, "NextChoiceId": 4, "NextAnswerId": 1, "QuestionID": "QID4"}}, {"SurveyID": "SV_R6SKIcegNVUE53B", "Element": "SQ", "PrimaryAttribute": "QID5", "SecondaryAttribute": "Attention check", "TertiaryAttribute": null, "Payload": {"QuestionText": "To show you are reading carefully, please select <b>“Very important”</b> below, regardless of your actual opinion.", "QuestionText_Unsafe": "To show you are reading carefully, please select <b>“Very important”</b> below, regardless of your actual opinion.", "DataExportTag": "attention_1", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "QuestionDescription": "Attention check", "Choices": {"1": {"Display": "Not at all important"}, "2": {"Display": "Slightly important"}, "3": {"Display": "Moderately important"}, "4": {"Display": "Very important"}, "5": {"Display": "Extremely important"}}, "ChoiceOrder": ["1", "2", "3", "4", "5"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "GradingData": [], "Language": [], "DataVisibility": {"Private": false, "Hidden": false}, "DefaultChoices": false, "NextChoiceId": 6, "NextAnswerId": 1, "QuestionID": "QID5"}}, {"SurveyID": "SV_R6SKIcegNVUE53B", "Element": "SQ", "PrimaryAttribute": "QID6", "SecondaryAttribute": "Attribute guide (pre-choice teaching page)", "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style='max-width:760px;margin:0 auto 14px;font-size:17px;font-weight:600;color:#111'>A quick guide before you choose</div>${e://Field/glossary_full}", "QuestionText_Unsafe": "<div style='max-width:760px;margin:0 auto 14px;font-size:17px;font-weight:600;color:#111'>A quick guide before you choose</div>${e://Field/glossary_full}", "DataExportTag": "spec_guide", "QuestionType": "DB", "Selector": "TB", "Configuration": {"QuestionDescriptionOption": "UseText"}, "QuestionDescription": "Attribute guide (pre-choice teaching page)", "ChoiceOrder": [], "Validation": {"Settings": {"Type": "None"}}, "GradingData": [], "Language": [], "DataVisibility": {"Private": false, "Hidden": false}, "DefaultChoices": false, "NextChoiceId": 4, "NextAnswerId": 1, "QuestionID": "QID6", "QuestionJS": ""}}, {"SurveyID": "SV_R6SKIcegNVUE53B", "Element": "SQ", "PrimaryAttribute": "QID7", "SecondaryAttribute": "Choice-page timer", "TertiaryAttribute": null, "Payload": {"QuestionText": "Timing", "QuestionText_Unsafe": "Timing", "QuestionType": "Timing", "Selector": "PageTimer", "DataExportTag": "choice_timing", "Configuration": {"MaxSeconds": "0", "MinSeconds": "0", "QuestionDescriptionOption": "UseText"}, "QuestionDescription": "Choice-page timer", "Validation": null, "GradingData": [], "Language": [], "DataVisibility": {"Private": false, "Hidden": false}, "DefaultChoices": false, "NextChoiceId": 4, "NextAnswerId": 1, "QuestionID": "QID7", "Choices": {"1": {"Display": "First Click"}, "2": {"Display": "Last Click"}, "3": {"Display": "Page Submit"}, "4": {"Display": "Click Count"}}}}, {"SurveyID": "SV_R6SKIcegNVUE53B", "Element": "SQ", "PrimaryAttribute": "QID8", "SecondaryAttribute": "Product table + choice", "TertiaryAttribute": null, "Payload": {"QuestionText": "<style>\n.cfx-stem{font-size:16px;line-height:1.55;color:#1a1a1a;max-width:920px;margin:0 auto 14px}\n.cfx-opts{max-width:920px;margin:0 auto;display:flex;flex-direction:column;gap:10px}\n.cfx-card{display:block;border:1px solid #cfd6dd;border-radius:10px;padding:12px 14px;cursor:pointer;background:#fff;transition:border-color .12s,box-shadow .12s}\n.cfx-card:hover{border-color:#9bb0c4}\n.cfx-card.sel{border-color:#1f5fae;box-shadow:0 0 0 2px rgba(31,95,174,.18)}\n.cfx-card input{margin-right:10px;transform:translateY(1px)}\n.cfx-cardbrand{font-weight:700;color:#16243a}\n.cfx-cardmodel{font-weight:400;color:#566;font-size:13px}\n.cfx-err{display:none;color:#b00020;max-width:920px;margin:0 auto 10px;font-size:15px}\n.cs-wrap{max-width:760px;margin:0 auto;font-size:15px;line-height:1.6;color:#222}\n.cs-actions{display:flex;gap:12px;margin-top:18px;flex-wrap:wrap}\n.cs-btn{font-size:15px;padding:10px 16px;border:1px solid #1f5fae;border-radius:8px;background:#fff;color:#1f5fae;cursor:pointer}\n.cs-btn.on{background:#1f5fae;color:#fff}\n.cs-note{margin-top:12px;color:#444;min-height:20px}\n.sb-prompt{max-width:920px;margin:0 auto 16px;font-size:15px;line-height:1.6;color:#222;background:#f4f6f8;border:1px solid #dde3e9;border-radius:8px;padding:14px 16px;white-space:pre-wrap}\n</style><div id='cfx-err' class='cfx-err'>The options could not be loaded. Please refresh the page; if this persists, return to Prolific and message us.</div><div id='sb-prompt' class='sb-prompt'></div><div id='sb-table'></div><div id='sb-gloss'></div><div id='cfx-stem' class='cfx-stem' style='margin-top:18px;font-weight:600'></div><div id='cfx-opts' class='cfx-opts'></div><textarea id='sb-prompt-data' style='display:none'>${e://Field/level_prompt}</textarea><textarea id='sb-table-data' style='display:none'>${e://Field/table_html}</textarea><textarea id='sb-gloss-data' style='display:none'>${e://Field/glossary_compact}</textarea><textarea id='sb-cards-data' style='display:none'>${e://Field/choice_cards}</textarea><textarea id='sb-stem-data' style='display:none'>${e://Field/choice_stem}</textarea><textarea id='sb-dompos-data' style='display:none'>${e://Field/shown_dominant_pos}</textarea><textarea id='sb-focalpos-data' style='display:none'>${e://Field/shown_focal_pos}</textarea><textarea id='sb-dombrand-data' style='display:none'>${e://Field/dominant_brand}</textarea><textarea id='sb-frame-data' style='display:none'>${e://Field/assigned_frame}</textarea>", "QuestionText_Unsafe": "<style>\n.cfx-stem{font-size:16px;line-height:1.55;color:#1a1a1a;max-width:920px;margin:0 auto 14px}\n.cfx-opts{max-width:920px;margin:0 auto;display:flex;flex-direction:column;gap:10px}\n.cfx-card{display:block;border:1px solid #cfd6dd;border-radius:10px;padding:12px 14px;cursor:pointer;background:#fff;transition:border-color .12s,box-shadow .12s}\n.cfx-card:hover{border-color:#9bb0c4}\n.cfx-card.sel{border-color:#1f5fae;box-shadow:0 0 0 2px rgba(31,95,174,.18)}\n.cfx-card input{margin-right:10px;transform:translateY(1px)}\n.cfx-cardbrand{font-weight:700;color:#16243a}\n.cfx-cardmodel{font-weight:400;color:#566;font-size:13px}\n.cfx-err{display:none;color:#b00020;max-width:920px;margin:0 auto 10px;font-size:15px}\n.cs-wrap{max-width:760px;margin:0 auto;font-size:15px;line-height:1.6;color:#222}\n.cs-actions{display:flex;gap:12px;margin-top:18px;flex-wrap:wrap}\n.cs-btn{font-size:15px;padding:10px 16px;border:1px solid #1f5fae;border-radius:8px;background:#fff;color:#1f5fae;cursor:pointer}\n.cs-btn.on{background:#1f5fae;color:#fff}\n.cs-note{margin-top:12px;color:#444;min-height:20px}\n.sb-prompt{max-width:920px;margin:0 auto 16px;font-size:15px;line-height:1.6;color:#222;background:#f4f6f8;border:1px solid #dde3e9;border-radius:8px;padding:14px 16px;white-space:pre-wrap}\n</style><div id='cfx-err' class='cfx-err'>The options could not be loaded. Please refresh the page; if this persists, return to Prolific and message us.</div><div id='sb-prompt' class='sb-prompt'></div><div id='sb-table'></div><div id='sb-gloss'></div><div id='cfx-stem' class='cfx-stem' style='margin-top:18px;font-weight:600'></div><div id='cfx-opts' class='cfx-opts'></div><textarea id='sb-prompt-data' style='display:none'>${e://Field/level_prompt}</textarea><textarea id='sb-table-data' style='display:none'>${e://Field/table_html}</textarea><textarea id='sb-gloss-data' style='display:none'>${e://Field/glossary_compact}</textarea><textarea id='sb-cards-data' style='display:none'>${e://Field/choice_cards}</textarea><textarea id='sb-stem-data' style='display:none'>${e://Field/choice_stem}</textarea><textarea id='sb-dompos-data' style='display:none'>${e://Field/shown_dominant_pos}</textarea><textarea id='sb-focalpos-data' style='display:none'>${e://Field/shown_focal_pos}</textarea><textarea id='sb-dombrand-data' style='display:none'>${e://Field/dominant_brand}</textarea><textarea id='sb-frame-data' style='display:none'>${e://Field/assigned_frame}</textarea>", "DataExportTag": "rec_choice_widget", "QuestionType": "DB", "Selector": "TB", "Configuration": {"QuestionDescriptionOption": "UseText"}, "QuestionDescription": "Product table + choice", "ChoiceOrder": [], "Validation": {"Settings": {"Type": "None"}}, "GradingData": [], "Language": [], "DataVisibility": {"Private": false, "Hidden": false}, "DefaultChoices": false, "NextChoiceId": 4, "NextAnswerId": 1, "QuestionID": "QID8", "QuestionJS": "Qualtrics.SurveyEngine.addOnload(function(){});\nQualtrics.SurveyEngine.addOnReady(function(){\n  var self=this;\n  function ed(k,v){ try{ Qualtrics.SurveyEngine.setEmbeddedData(k,v); }catch(e){} }\n  function $(id){ return document.getElementById(id); }\n  self.hideNextButton();\n  var gs=document.createElement('style'); gs.id='cfx-gate';\n  gs.textContent='#NextButton,input[id=\\\"NextButton\\\"]{display:none !important;visibility:hidden !important;pointer-events:none !important;}#PreviousButton{display:none !important;}';\n  document.head.appendChild(gs); var done=false;\n  var obs=new MutationObserver(function(){ if(done)return; if(!document.getElementById('cfx-gate'))document.head.appendChild(gs); });\n  try{ obs.observe(document.head,{childList:true}); }catch(e){}\n  setTimeout(function(){ if(!done)self.hideNextButton(); },500);\n  setTimeout(function(){ if(!done)self.hideNextButton(); },2000);\n  setTimeout(function(){ if(!done)self.hideNextButton(); },5000);\n  Qualtrics.SurveyEngine.addOnPageSubmit(function(type){ if(type==='next'&&!done){ try{Qualtrics.SurveyEngine.setEmbeddedData('bypass_attempt','true');}catch(e){} } });\n  function unlock(){ if(done)return; done=true; try{obs.disconnect();}catch(e){}\n    var g=document.getElementById('cfx-gate'); if(g&&g.parentNode)g.parentNode.removeChild(g);\n    try{self.showNextButton();}catch(e){}\n    var nb=document.getElementById('NextButton'); if(nb){nb.style.display='';nb.style.visibility='';nb.style.pointerEvents='';nb.removeAttribute('disabled');}\n    setTimeout(function(){try{self.showNextButton();}catch(e){}},120); }\n  function val(id){ var e=$(id); return e?e.value:''; }\n  $('sb-prompt').innerHTML = val('sb-prompt-data');\n  $('sb-table').innerHTML = val('sb-table-data');\n  $('sb-gloss').innerHTML = val('sb-gloss-data');\n  $('cfx-stem').innerHTML = val('sb-stem-data');\n  var domPos = parseInt(val('sb-dompos-data'),10);\n  var focalPos = parseInt(val('sb-focalpos-data'),10);\n  var cards; try{ cards=JSON.parse(val('sb-cards-data')||'[]'); }catch(e){ cards=[]; }\n  if(!cards.length){ var er=$('cfx-err'); if(er)er.style.display='block'; return; }\n  var wrap=$('cfx-opts');\n  cards.forEach(function(c,i){\n    var card=document.createElement('label'); card.className='cfx-card';\n    card.innerHTML=\"<input type='radio' name='cfx-rec' value='\"+(i+1)+\"'>\"+\n      \"<span class='cfx-cardbrand'>\"+c.brand+\"</span> <span class='cfx-cardmodel'>\"+c.model+\"</span>\";\n    card.querySelector('input').addEventListener('change',function(){\n      var pos=i+1;\n      ed('choice_index', String(pos)); ed('choice_code', c.code);\n      ed('choice_brand', c.brand);\n      ed('choice_is_optimal', pos===domPos ? '1':'0');\n      ed('choice_is_focal', pos===focalPos ? '1':'0');\n      var domBrand=val('sb-dombrand-data'), frm=val('sb-frame-data');\n      function joinNeeds(arr){ if(!arr||!arr.length) return ''; if(arr.length===1) return arr[0]; if(arr.length===2) return arr[0]+' and '+arr[1]; return arr.slice(0,-1).join(', ')+', and '+arr[arr.length-1]; }\n      var ct;\n      if(pos===domPos){ ct=(frm==='advise_other')?('You recommended the '+c.brand+' to your friend. Can you say a bit more about what made it the best choice for them?'):('You chose the '+c.brand+'. Can you say a bit more about what made it the best choice for you?'); }\n      else { var needs=joinNeeds(c.fails); var care=(frm==='advise_other')?'your friend asked for':'you said you wanted'; var didv=(frm==='advise_other')?'recommended':'chose'; var tof=(frm==='advise_other')?' to your friend':''; ct='Looking again at the table, the '+domBrand+', which you did not choose, meets '+needs+' (which '+care+') and the '+c.brand+' you picked does not, at a lower price. Can you say a bit more about why you '+didv+' the '+c.brand+tof+'?'; }\n      ed('challenge_text', ct);\n      var cs=wrap.querySelectorAll('.cfx-card'); for(var k=0;k<cs.length;k++){cs[k].classList.remove('sel');}\n      card.classList.add('sel'); unlock();\n    });\n    wrap.appendChild(card);\n  });\n});\n"}}, {"SurveyID": "SV_R6SKIcegNVUE53B", "Element": "SQ", "PrimaryAttribute": "QID9", "SecondaryAttribute": "Free-text why", "TertiaryAttribute": null, "Payload": {"QuestionText": "<span style='font-size:16px'>In your own words, why did you pick that option? Please explain your reasoning in a sentence or two.</span>", "QuestionText_Unsafe": "<span style='font-size:16px'>In your own words, why did you pick that option? Please explain your reasoning in a sentence or two.</span>", "DataExportTag": "why_free_text", "QuestionType": "TE", "Selector": "ML", "Configuration": {"QuestionDescriptionOption": "UseText"}, "QuestionDescription": "Free-text why", "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "GradingData": [], "Language": [], "DataVisibility": {"Private": false, "Hidden": false}, "DefaultChoices": false, "SearchSource": {"AllowFreeResponse": "false"}, "NextChoiceId": 4, "NextAnswerId": 1, "QuestionID": "QID9"}}, {"SurveyID": "SV_R6SKIcegNVUE53B", "Element": "SQ", "PrimaryAttribute": "QID10", "SecondaryAttribute": "Comprehension check (application item; scored against comp_correct)", "TertiaryAttribute": null, "Payload": {"QuestionText": "${e://Field/comp_q}", "QuestionText_Unsafe": "${e://Field/comp_q}", "DataExportTag": "comprehension_1", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "QuestionDescription": "Comprehension check (application item; scored against comp_correct)", "Choices": {"1": {"Display": "${e://Field/comp_opt1}"}, "2": {"Display": "${e://Field/comp_opt2}"}, "3": {"Display": "${e://Field/comp_opt3}"}}, "ChoiceOrder": ["1", "2", "3"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "GradingData": [], "Language": [], "DataVisibility": {"Private": false, "Hidden": false}, "DefaultChoices": false, "NextChoiceId": 4, "NextAnswerId": 1, "QuestionID": "QID10"}}, {"SurveyID": "SV_R6SKIcegNVUE53B", "Element": "SQ", "PrimaryAttribute": "QID11", "SecondaryAttribute": "Brand influence (forced probe)", "TertiaryAttribute": null, "Payload": {"QuestionText": "<span style='font-size:16px'>How much did the product's brand name influence which option you picked?</span>", "QuestionText_Unsafe": "<span style='font-size:16px'>How much did the product's brand name influence which option you picked?</span>", "DataExportTag": "brand_influence", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "QuestionDescription": "Brand influence (forced probe)", "Choices": {"1": {"Display": "Not at all"}, "2": {"Display": "A little"}, "3": {"Display": "A moderate amount"}, "4": {"Display": "A lot"}, "5": {"Display": "It was the main reason"}}, "ChoiceOrder": ["1", "2", "3", "4", "5"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "GradingData": [], "Language": [], "DataVisibility": {"Private": false, "Hidden": false}, "DefaultChoices": false, "NextChoiceId": 6, "NextAnswerId": 1, "QuestionID": "QID11"}}, {"SurveyID": "SV_R6SKIcegNVUE53B", "Element": "SQ", "PrimaryAttribute": "QID12", "SecondaryAttribute": "Social-proof influence (forced probe)", "TertiaryAttribute": null, "Payload": {"QuestionText": "<span style='font-size:16px'>How much did the products' star ratings and number of reviews influence which option you picked?</span>", "QuestionText_Unsafe": "<span style='font-size:16px'>How much did the products' star ratings and number of reviews influence which option you picked?</span>", "DataExportTag": "social_proof_influence", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "QuestionDescription": "Social-p